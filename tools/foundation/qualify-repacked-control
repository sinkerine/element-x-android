"""Require qualified unmodified artifact to retain the original regression failures.

Caller owns external build guards and resource admission. Uses direct gradlew because
reacquiring tools/gradle-local.sh's shared lock under the caller would deadlock.
"""
import json
import os
from pathlib import Path
import subprocess
import sys
import xml.etree.ElementTree as ET


def main():
    source_only = sys.argv[1:] == ["--reproduce-qualified"]
    if sys.argv[1:] and not source_only:
        raise RuntimeError("Only --reproduce-qualified is supported")
    root = Path(__file__).resolve().parents[2]
    work = root / "build/foundation-private"
    work.mkdir(parents=True, exist_ok=True)
    logs = work / "repacked-control-logs"
    logs.mkdir(exist_ok=True)
    env = dict(os.environ)
    results = {"mode": "reproduce-qualified-output-no-tests" if source_only else "initial-control-RED-qualification"}

    def run(label, command, expect_red=False):
        with (logs / (label + ".log")).open("w") as output:
            result = subprocess.run(command, cwd=root, env=env, stdout=output, stderr=subprocess.STDOUT)
        results[label] = {"command": command, "exit_code": result.returncode}
        (work / "repacked-control-stages.json").write_text(json.dumps(results, indent=2) + "\n")
        if (not expect_red and result.returncode != 0) or (expect_red and result.returncode != 1):
            raise RuntimeError(f"Unexpected {label} exit {result.returncode}; inspect {logs}")

    for tool in ("qualify-control", "repack-control", "publish-control"):
        run(tool, [sys.executable, str(root / "tools/foundation" / tool)])
    if source_only:
        print("Unmodified source-family reproduction PASS; no control tests executed and no new qualification claimed")
        return
    env["FOUNDATION_CONTROL_MANIFEST"] = str(work / "control-repository.json")
    tests = (
        ("libraries/designsystem", "io.element.android.libraries.designsystem.theme.components.AnchoredDraggableStateTest", 3),
        ("features/messages/impl", "io.element.android.features.messages.impl.actionlist.ActionListSheetInsetsTest", 2),
    )
    for module, name, count in tests:
        label = name.rsplit(".", 1)[-1]
        report = root / module / "build/test-results/testDebugUnitTest" / ("TEST-" + name + ".xml")
        report.unlink(missing_ok=True)
        command = [str(root / "gradlew"), "--no-daemon", "--no-configuration-cache", "--no-parallel", "--max-workers=2",
                   "-Dorg.gradle.jvmargs=-Xmx3g -Dfile.encoding=UTF-8 -XX:+UseG1GC", "-Pkotlin.daemon.jvmargs=-Xmx1g",
                   "-I", str(root / "tools/foundation/control-test.init.gradle"),
                   ":" + module.replace("/", ":") + ":testDebugUnitTest", "--tests", name]
        run(label, command, expect_red=True)
        if "Qualified unmodified Foundation control:" not in (logs / (label + ".log")).read_text():
            raise RuntimeError("Actual Test classpath control identity not proven")
        suite = ET.parse(report).getroot()
        if any(int(suite.attrib[key]) != expected for key, expected in {"tests": count, "failures": count, "errors": 0, "skipped": 0}.items()):
            raise RuntimeError("Unexpected regression test result set: " + name)
        cases = suite.findall("testcase")
        if len(cases) != count or any(case.find("failure") is None or "Assertion" not in case.find("failure").attrib.get("type", "") for case in cases):
            raise RuntimeError("Expected original assertion failures, not infrastructure errors: " + name)
        (logs / report.name).write_bytes(report.read_bytes())
    print("Repackaged UNMODIFIED control retains 3 state and 2 wrapper assertion failures; patch still uncompiled")


if __name__ == "__main__":
    main()
